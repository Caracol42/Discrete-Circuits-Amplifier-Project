* ============================================================
* IRF9510 P-Channel MOSFET
* External terminals:
* 1 = Drain
* 2 = Gate
* 3 = Source
* ============================================================

.SUBCKT IRF9510 1 2 3

*      Model Generated by MODPEX
* Model Format: SPICE3
* Node 1 -> Drain
* Node 2 -> Gate
* Node 3 -> Source

M1 9 7 8 8 MM L=100u W=100u

.MODEL MM PMOS LEVEL=1 IS=1e-32
+VTO=-3.57642
+LAMBDA=0.0460774
+KP=2.37219
+CGSO=1.87951e-06
+CGDO=1e-11

RS 8 3 0.44653

D1 1 3 MD

.MODEL MD D IS=1e-17 RS=1.82019 N=1.5 BV=300
+IBV=10 EG=1.2 XTI=4 TT=0.0001
+CJO=2.48404e-10 VJ=2.94139 M=0.52327 FC=0.5

RDS 3 1 1e+06

RD 9 1 0.266355

RG 2 7 19.8686

D2 5 4 MD1

.MODEL MD1 D IS=1e-32 N=50
+CJO=1.36657e-10 VJ=1.84106 M=0.760823 FC=1e-08

D3 5 0 MD2

.MODEL MD2 D IS=1e-10 N=0.4 RS=3e-06

RL 5 10 1

FI2 7 9 VFI2 -1
VFI2 4 0 0

EV16 10 0 9 7 1

CAP 11 10 3.6009e-10

FI1 7 9 VFI1 -1
VFI1 11 6 0

RCAP 6 10 1

D4 6 0 MD3

.MODEL MD3 D IS=1e-10 N=0.4

.ENDS IRF9510