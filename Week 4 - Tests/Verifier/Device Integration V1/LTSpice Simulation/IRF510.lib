* ============================================================
* IRF510 N-Channel Power MOSFET
* External terminals:
* 1 = Drain
* 2 = Gate
* 3 = Source
* ============================================================

.SUBCKT IRF510 1 2 3

M1 9 7 8 8 MM L=100u W=100u

.MODEL MM NMOS LEVEL=1 IS=1e-32
+VTO=3.82703 LAMBDA=0 KP=2.48457
+CGSO=1.72132e-06 CGDO=5.99235e-11

RS 8 3 0.276929

D1 3 1 MD

.MODEL MD D IS=6.52734e-11 RS=0.0458243 N=1.2565 BV=100
+IBV=10 EG=1.2 XTI=1 TT=-2.05283e-09
+CJO=2.98645e-10 VJ=0.774158 M=0.422859 FC=0.5

RDS 3 1 1e+06

RD 9 1 0.0673242

RG 2 7 13.1694

D2 4 5 MD1

.MODEL MD1 D IS=1e-32 N=50
+CJO=1.85121e-10 VJ=0.500044 M=0.651006 FC=1e-08

D3 0 5 MD2

.MODEL MD2 D IS=1e-10 N=0.4 RS=3e-06

RL 5 10 1

FI2 7 9 VFI2 -1

VFI2 4 0 0

EV16 10 0 9 7 1

CAP 11 10 3.40332e-10

FI1 7 9 VFI1 -1

VFI1 11 6 0

RCAP 6 10 1

D4 0 6 MD3

.MODEL MD3 D IS=1e-10 N=0.4

.ENDS IRF510